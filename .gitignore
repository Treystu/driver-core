# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime state. The audit log is evidence about a machine, not source:
# it must never be committed, and a stray one in the tree is a leak.
*.jsonl
audit.jsonl
*.baseline.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent/tool working state (installed skills, recovered sessions, cold-run copies).
# Not source: these are per-seat artifacts and a cold-run copy is a duplicate
# of the tree, never evidence the repo should carry.
.agents/
.freebuff/
.verify/
